<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>hv</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeworkValidator.Core\HomeworkValidator.Core.csproj" />
  </ItemGroup>

  <!-- Ship the course databases and assignments next to the executable. -->
  <ItemGroup>
    <None Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

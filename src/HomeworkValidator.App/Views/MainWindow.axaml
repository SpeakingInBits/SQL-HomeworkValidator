<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HomeworkValidator.App.ViewModels"
        xmlns:views="using:HomeworkValidator.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="HomeworkValidator.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Title="SQL Homework Validator"
        Width="1200" Height="800" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <!-- Which view to show for each page view model. ContentControl below picks the matching template. -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:ConnectionViewModel">
            <views:ConnectionView />
        </DataTemplate>
        <DataTemplate DataType="vm:WorkspaceViewModel">
            <views:WorkspaceView />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <!-- A newer version has been downloaded. It installs the next time the app opens, or now with Restart. -->
        <Border DockPanel.Dock="Top" Classes="banner pass" Margin="16,8,16,0"
                IsVisible="{Binding UpdateVersion, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding UpdateVersion, StringFormat='Version {0} is ready. It installs the next time you open the app, or restart now.'}" />
                <Button Grid.Column="1" Content="Restart now" Command="{Binding RestartToUpdateCommand}" />
            </Grid>
        </Border>

        <Panel>
            <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding ContentError, Converter={x:Static ObjectConverters.IsNull}}" />
            <TextBlock Text="{Binding ContentError}"
                       IsVisible="{Binding ContentError, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Classes="fail" TextWrapping="Wrap" Margin="32" />
        </Panel>
    </DockPanel>
</Window>

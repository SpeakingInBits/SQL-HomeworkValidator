<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe's icon, which Windows also uses for its shortcuts. Made from packaging/app-icon/icon.svg. -->
    <ApplicationIcon>..\..\packaging\app-icon\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window's icon (title bar and taskbar), the same file as the .exe's. -->
    <AvaloniaResource Include="..\..\packaging\app-icon\icon.ico" Link="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    <!-- Updates the installed app from the GitHub releases. Keep in step with vpk in .github/workflows/release.yml. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeworkValidator.Core\HomeworkValidator.Core.csproj" />
  </ItemGroup>

  <!-- Ship the course databases and assignments next to the executable. -->
  <ItemGroup>
    <None Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
